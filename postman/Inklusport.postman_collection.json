                "pm.test(\"Tiene email o id\", function () {",
                "    pm.expect(!!(json.email || json.id || json.fullName)).to.eql(true);",
                "});",
                "if (json.id) {",
                "    pm.collectionVariables.set(\"userId\", String(json.id));",
                "    pm.environment.set(\"userId\", String(json.id));",
                "}"
              ]
