{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-4789-a012-inklusport0001",
    "name": "Inklusport = Postman + Newman",
    "description": "Una carpeta = un microservicio, todas las URLs pasan por el gateway ({{baseUrl}}).\n\nNewman por servicio:\nnewman run Inklusport.postman_collection.json -e Inklusport.local.postman_environment.json --folder \"03 — Sports\"",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"El gateway enruta (no es 404)\", function () {",
          "    pm.expect(pm.response.code).to.not.equal(404);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "email", "value": "demo@inklusport.uk" },
    { "key": "password", "value": "Demo1234!" },
    { "key": "conversacion_id", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "00 — Salud gateway",
      "item": [
        {
          "name": "GET salud IA",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"200 JSON\", function () {",
                "    pm.response.to.have.status(200);",
                "    pm.response.to.be.json;",
                "});"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ai/health",
            "description": "ink-ms-ai-assistant vía gateway. Sin JWT."
          }
        },
        {
          "name": "GET diagnóstico IA (dependencias)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Diagnóstico responde 200\", function () {",
                "    pm.response.to.have.status(200);",
                "});"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ai/diagnostico",
            "description": "El asistente comprueba si ve auth, users, sports, etc."
          }
        }
      ]
    },
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "POST login (guarda JWT)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Login 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "const token = json.token || json.accessToken || json.jwt || json.access_token;",
                "pm.test(\"Hay JWT\", function () {",
                "    pm.expect(token).to.be.a(\"string\").and.to.have.lengthOf.above(20);",
                "});",
                "if (token) {",
                "    pm.collectionVariables.set(\"token\", token);",
                "    pm.environment.set(\"token\", token);",
                "}"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "ink-ms-auth. Guarda {{token}} para el resto de carpetas."
          }
        },
        {
          "name": "GET validar JWT",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Token válido (200)\", function () { pm.response.to.have.status(200); });"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/validate",
            "description": "GET /api/auth/validate — comprueba el Bearer."
          }
        },
        {
          "name": "POST login inválido (4xx)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Rechaza credenciales malas\", function () {",
                "    pm.expect([400, 401, 403]).to.include(pm.response.code);",
                "});"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nadie@inklusport.uk\",\n  \"password\": \"clave-incorrecta\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Prueba negativa: 400/401 es PASSED."
          }
        }
      ]
    },
