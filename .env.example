# Inklusport - Variables de entorno
# Copia este archivo como .env en la raÃ­z del proyecto y rellena los valores.
# Este fichero SÃ se versiona, asÃ­ que nunca escribas secretos reales aquÃ­.

# ---------------------------------------------------------------------------
# JWT â€” obligatorio. Debe ser idÃ©ntico en todos los microservicios, porque uno
# firma los tokens y los demÃ¡s los validan.
# Los servicios NO tienen valor por defecto: si esto falta, no arrancan.
# Genera uno nuevo con:
#   PowerShell -> [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}))
#   Linux/macOS -> openssl rand -base64 64 | tr -d '\n'
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# Acceso con Google (OAuth 2.0 - Google Cloud Console)
# Crea credenciales de tipo "ID de cliente de OAuth" > "AplicaciÃ³n web".
# Cuando haya frontend, aÃ±ade sus orÃ­genes (p. ej. http://localhost:4200)
# y copia el mismo Client ID en la config del front.
# Si se deja vacÃ­o, el acceso con Google queda deshabilitado.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Google Maps (ubicaciones de eventos)
# En Google Cloud: Maps JavaScript API + Places API.
# Restringe la key a http://localhost:4200/* y https://inklusport.inklusport.uk/*
# Local (ng serve): pega la key en ink-ms-frontend/src/assets/config.json
# Docker: define GOOGLE_MAPS_API_KEY aquÃ­; el entrypoint la inyecta al arrancar.
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Bases de datos
# Los nombres de host (mysql, mongodb) son los del docker-compose local.
# En un despliegue remoto se sobrescriben con los de la base gestionada.
# ---------------------------------------------------------------------------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DATABASE=accessibility_notifications_db

# ---------------------------------------------------------------------------
# Email (auth: recuperar contraseÃ±a; accessibility: notificaciones)
# Con MAIL_ENABLED=false
# Para Gmail: usa App Password (cuenta Google > Seguridad) y pon MAIL_ENABLED=true
# Accessibility necesita USERS_SERVICE_URL para resolver UUID->email no se envÃ­an correos y no hace falta configurar SMTP.
# Si usas Gmail necesitas una contraseÃ±a de aplicaciÃ³n, no la del correo.
# ---------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PROTOCOL=smtps
MAIL_ENABLED=false
# Para Gmail: usa App Password (cuenta Google > Seguridad) y pon MAIL_ENABLED=true
# Accessibility necesita USERS_SERVICE_URL para resolver UUID->email
EXPOSE_TOKEN=false
TOKEN_EXPIRY_HOURS=24

# Correos admin (separados por coma) para alertas administrativas y fan-out
# (tambiÃ©n se notifican usuarios con rol ADMIN en la BD).
# NOTIFICATION_ADMIN_EMAILS=admin@inklusport.com

# ---------------------------------------------------------------------------
# Comportamiento por entorno
# En producciÃ³n: LOG_LEVEL=INFO y SHOW_SQL=false (si no, se registra cada query).
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
SHOW_SQL=true
JPA_DDL_AUTO=update
FEIGN_CIRCUITBREAKER=true

# ---------------------------------------------------------------------------
# Suscripciones / pasarela de pago (ink-ms-suscriptions)
# mode=mock aprueba pagos localmente; external deja el pago PENDIENTE
# hasta confirmar por webhook POST /api/payments/webhook
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY_MODE=mock
# PAYMENT_GATEWAY_URL=
# PAYMENT_GATEWAY_API_KEY=
SUBSCRIPTION_WARNING_DAYS=7

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (acceso pÃºblico: https://inklusport.inklusport.uk/)
# Token del tÃºnel (Zero Trust > Networks > Tunnels > Configure > token).
# El hostname del tÃºnel debe apuntar a http://frontend-service:80
# (nginx sirve Angular y proxea /api al gateway).
# Sin este valor el contenedor inklusport-cloudflared no puede conectar
# y verÃ¡s Error 1033.
# Nombre exacto: CLOUDFLARE_TOKEN (no CLAUDFLARE_TOKEN).
# ---------------------------------------------------------------------------
CLOUDFLARE_TOKEN=

# ---------------------------------------------------------------------------
# Asistente de IA (ink-ms-ai-assistant â†’ gateway /api/ai/**)
# En local/dev la clave vive en ink-ms-ai-assistant/.env (env_file del compose).
# En prod (docker-compose.prod.yml) estas variables van en .env.prod:
# ---------------------------------------------------------------------------
# AI_MONGODB_URI=mongodb://user:pass@host:27017/
# AI_MONGODB_DB=inclusport_training_ia
# LLM_ENABLED=true
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=google/gemma-4-31b-it:free
# En xAI preferir grok-4.3 (mejor ratio calidad/precio que 4.5)
# REGISTRY=tu-acr.azurecr.io
# TAG=latest
#
# Modelo usado sÃ³lo si levantas el LLM local, que es opcional:
#   docker compose --profile llm-local up -d
# ---------------------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:3b

