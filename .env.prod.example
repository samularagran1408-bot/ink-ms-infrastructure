# Copia este fichero a .env.prod y rellena los valores reales.
# NUNCA subas .env.prod a Git.

# ---------------------------------------------------------------------------
# Registry de imágenes (ACR, Docker Hub, etc.)
# ---------------------------------------------------------------------------
REGISTRY=tuacr.azurecr.io
TAG=v1

# ---------------------------------------------------------------------------
# JWT — genera uno NUEVO, distinto del de desarrollo
# PowerShell: [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}))
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRATION=86400000

# ---------------------------------------------------------------------------
# MySQL gestionado (Azure Database / RDS / etc.)
# Formato JDBC típico Spring:
#   jdbc:mysql://HOST:3306/NOMBRE_DB?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# ---------------------------------------------------------------------------
MYSQL_USER=
MYSQL_PASSWORD=
AUTH_MYSQL_URL=jdbc:mysql://HOST:3306/auth_ms?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
USERS_MYSQL_URL=jdbc:mysql://HOST:3306/user_ms?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPORTS_MYSQL_URL=jdbc:mysql://HOST:3306/sports_events_ms?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
REPORTS_MYSQL_URL=jdbc:mysql://HOST:3306/analytics_ms?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SUBSCRIPTIONS_MYSQL_URL=jdbc:mysql://HOST:3306/inklusport_subscriptions?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ---------------------------------------------------------------------------
# MongoDB (Atlas o Cosmos DB API Mongo)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
MONGODB_DB=accessibility_notifications_db
AI_MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/?retryWrites=true&w=majority
AI_MONGODB_DB=inclusport_training_ia

# ---------------------------------------------------------------------------
# Comportamiento producción
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SHOW_SQL=false
JPA_DDL_AUTO=validate
MAIL_ENABLED=false
PAYMENT_GATEWAY_MODE=mock

# ---------------------------------------------------------------------------
# LLM (asistente IA)
# ---------------------------------------------------------------------------
LLM_ENABLED=true
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=google/gemma-4-31b-it:free

# Cloudinary (foto de perfil) — solo backend ink-ms-users
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
